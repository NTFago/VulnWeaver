COMPOSE_PROJECT_NAME=vulnweaver

UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

POSTGRES_USER=vulnweaver
POSTGRES_PASSWORD=vulnweaver_dev_only
POSTGRES_DB=vulnweaver
POSTGRES_PORT=55432

REDIS_PORT=56379

DATABASE_URL=postgresql+psycopg://vulnweaver:vulnweaver_dev_only@postgres:5432/vulnweaver
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_NAMESPACE=vulnweaver

PERSONAL_USERNAME=owner
# Mount a read-only UTF-8 file and set PERSONAL_PASSWORD_FILE to its container path.
PERSONAL_PASSWORD_FILE=/run/secrets/vulnweaver_personal_password
PERSONAL_PASSWORD_FILE_HOST=./secrets/personal_password.txt
ARTIFACT_STORE_ROOT=/var/lib/vulnweaver/artifacts
UPLOAD_MAX_BYTES=536870912
MAX_UPLOAD_CONCURRENCY=2
JSON_BODY_MAX_BYTES=1048576
SESSION_TTL_SECONDS=43200
LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCKOUT_SECONDS=300
MAX_PASSWORD_CONCURRENCY=2
MAX_ACTIVE_SESSIONS=8
SECURE_COOKIE=true

# Optional OpenAI-compatible model reachable from the analysis-plane network.
# Leave both URL and model empty to record review Jobs as visibly unconfigured failures.
REVIEW_MODEL_BASE_URL=
REVIEW_MODEL_NAME=
REVIEW_MODEL_API_KEY=
REVIEW_MODEL_TIMEOUT_SECONDS=60
REVIEW_MODEL_MAX_ATTEMPTS=2
REVIEW_MODEL_REPAIR_ATTEMPTS=1
REVIEW_MODEL_MIN_INTERVAL_SECONDS=0

DISPATCHER_BATCH_SIZE=100
DISPATCHER_POLL_INTERVAL_SECONDS=0.5
DISPATCHER_RETRY_BASE_SECONDS=1.0
DISPATCHER_RETRY_MAX_SECONDS=300.0
