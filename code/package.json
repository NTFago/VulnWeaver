{
  "name": "vulnweaver-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven agentic vulnerability discovery",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:python": "pnpm run check:ruff && pnpm run check:pyright && pnpm run check:pytest",
    "check:ruff": "uv run --no-sync ruff check .",
    "check:pyright": "pyright",
    "check:pytest": "uv run --no-sync pytest -n 4 --durations=20 --cov --cov-report=term-missing --cov-fail-under=80",
    "check:contracts": "uv run --no-sync python packages/contracts/scripts/generate_contracts.py --check",
    "check:typescript": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm --filter @vulnweaver/web run build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "pyright": "^1.1.413"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  }
}
