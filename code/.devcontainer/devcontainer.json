{
  "name": "VulnWeaver Development",
  "dockerComposeFile": [
    "../compose.yaml",
    "../compose.dev.yaml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspace/vulnweaver",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "cd code && uv sync --frozen && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker",
        "ms-python.mypy-type-checker",
        "ms-python.python",
        "svelte.svelte-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "python.defaultInterpreterPath": "/workspace/vulnweaver/code/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "code/tests"
        ]
      }
    }
  }
}
