#!/usr/local/bin/python3
"""Bounded AFL++ fuzzing entrypoint with deterministic, contract-shaped outputs.

The sandbox mounts the target/seed bundle at /input/input.bin and collects the
files listed in the request from --output-dir. Crash minimization uses afl-tmin;
crash stacks are captured with gdb. Clustering itself is performed by the
worker-side triage service from the reported stack frames.
"""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

SCHEMA_VERSION = "1.0.0"
SAFE_MEMBER = re.compile(r"^(vulnweaver-bundle\.json|target|seeds/[A-Za-z0-9][A-Za-z0-9._-]{0,255})$")
AFL_ENV = {
    "AFL_SKIP_CPUFREQ": "1",
    "AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES": "1",
    "AFL_NO_UI": "1",
    "AFL_NO_AFFINITY": "1",
    "AFL_DISABLE_CRASH_DUMP": "1",
    "ASAN_OPTIONS": "abort_on_error=1:symbolize=0:detect_leaks=0:allocator_may_return_null=1",
}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--profile", required=True)
    parser.add_argument("--input-bundle", type=Path, required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--max-executions", type=int, required=True)
    parser.add_argument("--max-duration-seconds", type=int, required=True)
    parser.add_argument("--max-crashes", type=int, required=True)
    parser.add_argument("--collect-coverage", action="store_true")
    args = parser.parse_args()
    if args.profile == "harness-compile":
        return compile_harness(args)
    if args.profile != "afl-qemu-casr":
        print(f"unsupported fuzz profile: {args.profile}", file=sys.stderr)
        return 2
    if args.max_executions < 1 or args.max_duration_seconds < 1 or args.max_crashes < 1:
        print("fuzz budgets must be positive", file=sys.stderr)
        return 2

    workdir = Path("/work") if _usable_workdir(Path("/work")) else Path(tempfile.mkdtemp(prefix="fuzz-")) / "run"
    workdir.mkdir(parents=True, exist_ok=True)
    output_dir = args.output_dir
    output_dir.mkdir(parents=True, exist_ok=True)
    try:
        bundle_dir = workdir / "bundle"
        bundle_dir.mkdir()
        _extract_bundle(args.input_bundle, bundle_dir)
        # The sandbox mounts /tmp as a noexec tmpfs; the target must live on
        # the exec-allowed /work tmpfs to be run by afl-fuzz.
        target = bundle_dir / "target"
        target.chmod(0o755)
        seeds_dir = workdir / "seeds"
        seeds_dir.mkdir()
        for index, seed in enumerate(sorted((bundle_dir / "seeds").iterdir())):
            shutil.copyfile(seed, seeds_dir / f"seed-{index:04d}")

        out_dir = workdir / "afl-out"
        env = {**os.environ, **AFL_ENV}
        afl_log = workdir / "afl-fuzz.log"
        with open(afl_log, "wb") as log:
            afl_fuzz = subprocess.run(
                [
                    "afl-fuzz",
                    "-i",
                    str(seeds_dir),
                    "-o",
                    str(out_dir),
                    "-m",
                    "none",
                    "-t",
                    "2000",
                    "-V",
                    str(args.max_duration_seconds),
                    "-E",
                    str(args.max_executions),
                    "--",
                    str(target),
                    "@@",
                ],
                env=env,
                stdout=log,
                stderr=subprocess.STDOUT,
                timeout=args.max_duration_seconds + 60,
            )
        if afl_fuzz.returncode not in (0, 1):
            print(f"afl-fuzz exited with {afl_fuzz.returncode}", file=sys.stderr)
            return 1

        stats = _parse_stats(out_dir / "default" / "fuzzer_stats")
        if int(stats.get("execs_done", "0")) <= 0:
            print("afl-fuzz completed no executions", file=sys.stderr)
            sys.stderr.write(afl_log.read_text(encoding="utf-8", errors="replace")[-2000:])
            return 1
        crash_dir = out_dir / "default" / "crashes"
        crashes = sorted(p for p in crash_dir.iterdir() if p.is_file()) if crash_dir.is_dir() else []
        selected = crashes[: args.max_crashes]

        minimized_dir = workdir / "minimized"
        minimized_dir.mkdir()
        manifest_entries: list[dict[str, object]] = []
        minimized_bytes: dict[str, bytes] = {}
        for index, crash in enumerate(selected):
            data = _minimize(target, crash, minimized_dir / f"{index:04d}", env)
            name = f"crash-{index + 1:04d}"
            minimized_bytes[name] = data
            manifest_entries.append(
                {
                    "input_path": name,
                    "input_digest": "sha256:" + hashlib.sha256(data).hexdigest(),
                    "signal": _crash_signal(target, crash, env),
                    "exit_code": None,
                    "stack_frames": _crash_stack(target, crash, env),
                }
            )

        with tarfile.open(output_dir / "minimized-inputs.tar", "w") as archive:
            for name in sorted(minimized_bytes):
                payload = minimized_bytes[name]
                info = tarfile.TarInfo(name)
                info.size = len(payload)
                info.mtime = 0
                archive.addfile(info, __import__("io").BytesIO(payload))

        (output_dir / "crash-manifest.json").write_text(
            json.dumps(
                {"schema_version": SCHEMA_VERSION, "crashes": manifest_entries},
                ensure_ascii=True,
                sort_keys=True,
            ),
            encoding="utf-8",
        )
        coverage_percent = (
            _coverage_percent(target, out_dir, crashes, seeds_dir, env)
            if args.collect_coverage
            else None
        )
        (output_dir / "fuzz-summary.json").write_text(
            json.dumps(
                {
                    "schema_version": SCHEMA_VERSION,
                    "executions": int(stats.get("execs_done", "0")),
                    "coverage_percent": coverage_percent,
                },
                ensure_ascii=True,
                sort_keys=True,
            ),
            encoding="utf-8",
        )
        return 0
    except Exception as error:  # the structured outputs are the tool contract
        print(f"fuzz entrypoint failed: {error}", file=sys.stderr)
        return 1
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


def compile_harness(args: argparse.Namespace) -> int:
    """Build the generated harness with the image's AFL instrumentation.

    Only the harness source is model-authored; the command line, toolchain and
    flags are fixed here so no caller-supplied argument reaches the compiler.
    The compiled harness is returned as a tar so the Runner can publish it to CAS.
    """
    workdir = Path("/work") if _usable_workdir(Path("/work")) else Path(tempfile.mkdtemp(prefix="compile-"))
    workdir.mkdir(parents=True, exist_ok=True)
    output_dir = args.output_dir
    output_dir.mkdir(parents=True, exist_ok=True)
    diagnostics: list[str] = []
    message = ""
    success = False
    try:
        bundle_dir = workdir / "bundle"
        bundle_dir.mkdir()
        _extract_bundle(args.input_bundle, bundle_dir)
        source = bundle_dir / "harness.c"
        if not source.is_file():
            raise ValueError("harness bundle has no harness.c")
        binary = workdir / "harness"
        compile_env = {
            **os.environ,
            "AFL_QUIET": "1",
            "AFL_NOOPT": "0",
            "AFL_USE_ASAN": "1",
        }
        result = subprocess.run(
            [
                "afl-cc",
                "-O1",
                "-g",
                "-fno-omit-frame-pointer",
                "-o",
                str(binary),
                str(source),
                "-I",
                str(bundle_dir),
            ],
            env=compile_env,
            capture_output=True,
            text=True,
            timeout=300,
        )
        if result.returncode != 0:
            message = "harness compilation failed"
            diagnostics = _compiler_diagnostics(result.stderr or result.stdout)
        elif not binary.is_file():
            message = "compiler reported success without producing a binary"
        else:
            with tarfile.open(output_dir / "harness.tar", "w") as archive:
                payload = binary.read_bytes()
                info = tarfile.TarInfo("harness")
                info.size = len(payload)
                info.mtime = 0
                info.mode = 0o755
                archive.addfile(info, io.BytesIO(payload))
            success = True
    except Exception as error:  # the structured report is the tool contract
        message = f"harness compile step failed: {error}"
    (output_dir / "compile-report.json").write_text(
        json.dumps(
            {
                "schema_version": SCHEMA_VERSION,
                "success": success,
                "message": message[:512],
                "diagnostics": diagnostics[:50],
            },
            ensure_ascii=True,
            sort_keys=True,
        ),
        encoding="utf-8",
    )
    shutil.rmtree(workdir, ignore_errors=True)
    return 0


def _compiler_diagnostics(output: str) -> list[str]:
    """Keep the bounded compiler lines that a repair attempt can act on."""
    lines = [line.strip()[:512] for line in output.splitlines() if "error" in line.lower()]
    return lines[:50] or [output.strip()[:512]]


def _usable_workdir(path: Path) -> bool:
    probe = path / ".probe"
    try:
        path.mkdir(parents=True, exist_ok=True)
        shutil.copyfile("/bin/true", probe)
        os.chmod(probe, 0o755)
        result = subprocess.run([str(probe)], capture_output=True, timeout=5)
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False
    finally:
        probe.unlink(missing_ok=True)


def _extract_bundle(bundle: Path, destination: Path) -> None:
    with tarfile.open(bundle, "r:") as archive:
        for member in archive:
            if not member.isreg() or not SAFE_MEMBER.fullmatch(member.name):
                raise ValueError(f"unsafe bundle member: {member.name}")
            if member.size > 256 * 1024 * 1024:
                raise ValueError("bundle member exceeds the size budget")
            archive.extract(member, destination, filter="data")


def _parse_stats(path: Path) -> dict[str, str]:
    if not path.is_file():
        return {}
    stats: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            stats[key.strip()] = value.strip()
    return stats


def _minimize(target: Path, crash: Path, destination: Path, env: dict[str, str]) -> bytes:
    result = subprocess.run(
        ["afl-tmin", "-m", "none", "-t", "5000", "-i", str(crash), "-o", str(destination), "--", str(target), "@@"],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if result.returncode == 0 and destination.is_file():
        data = destination.read_bytes()
        if data:
            return data
    return crash.read_bytes()


def _run_target_under_gdb(target: Path, crash: Path, env: dict[str, str]) -> str:
    try:
        result = subprocess.run(
            [
                "gdb",
                "-batch",
                "-ex",
                "run",
                "-ex",
                "info registers eip rip",
                "-ex",
                "bt",
                "--args",
                str(target),
                str(crash),
            ],
            env=env,
            capture_output=True,
            timeout=20,
            text=True,
        )
        return result.stdout + result.stderr
    except (OSError, subprocess.TimeoutExpired):
        return ""


def _crash_signal(target: Path, crash: Path, env: dict[str, str]) -> str | None:
    output = _run_target_under_gdb(target, crash, env)
    match = re.search(r"Program received signal (SIG\w+)", output)
    return match.group(1) if match else None


def _crash_stack(target: Path, crash: Path, env: dict[str, str]) -> list[str]:
    output = _run_target_under_gdb(target, crash, env)
    frames: list[str] = []
    for line in output.splitlines():
        match = re.match(r"^(#\d+)\s+(.*)", line.strip())
        if match:
            location = re.sub(r"\b0x[0-9a-f]+\b", "", match.group(2))
            frames.append(f"{match.group(1)} {location.strip()}")
        if len(frames) >= 16:
            break
    return frames


def _showmap_edges(target: Path, files: list[Path], env: dict[str, str]) -> frozenset[int]:
    # afl-showmap directory merge mode is unreliable under the fork server,
    # so each input is measured separately and merged here.
    edges: set[int] = set()
    output = Path(tempfile.mkstemp()[1])
    try:
        for item in files[:200]:
            result = subprocess.run(
                ["afl-showmap", "-m", "none", "-t", "5000", "-o", str(output), "--", str(target), str(item)],
                env=env,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=20,
            )
            if result.returncode != 0:
                continue
            for line in output.read_text(encoding="utf-8", errors="replace").splitlines():
                if ":" in line:
                    edges.add(int(line.split(":", 1)[0]))
        return frozenset(edges)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return frozenset(edges)
    finally:
        output.unlink(missing_ok=True)


def _coverage_percent(
    target: Path,
    out_dir: Path,
    crashes: list[Path],
    seeds_dir: Path,
    env: dict[str, str],
) -> float | None:
    queue_dir = out_dir / "default" / "queue"
    if not queue_dir.is_dir():
        return None
    corpus_files = sorted(p for p in queue_dir.iterdir() if p.is_file())
    corpus_edges = _showmap_edges(target, corpus_files, env)
    if not corpus_edges:
        return None
    everything = sorted(corpus_files) + list(crashes) + sorted(seeds_dir.iterdir())
    universe_edges = _showmap_edges(target, [f for f in everything if f.is_file()], env)
    if not universe_edges:
        return None
    return round(100.0 * len(corpus_edges) / len(universe_edges), 2)


if __name__ == "__main__":
    signal.signal(signal.SIGALRM, lambda *_: sys.exit(1))
    raise SystemExit(main())
