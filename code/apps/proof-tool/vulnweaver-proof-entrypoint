#!/usr/local/bin/python3
"""Run a constrained invocation against one immutable Python source target.

The model supplies only a callable path and input encoding; it cannot supply
Python code. The trusted entrypoint compiles the digest-checked target bytes
in memory, calls the selected function, and attributes exceptions by code
object identity. The target is never materialized as a writable file.
"""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import re
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path

MANIFEST_NAME = "vulnweaver-execution-bundle.json"
DRIVER_NAME = "driver.json"
TARGET_NAME = "target"
INPUT_PREFIX = "inputs/"
CONTROL_PREFIX = "controls/"
REPORT_NAME = "execution-report.json"

MAX_BUNDLE_BYTES = 256 * 1024 * 1024
MAX_MEMBER_BYTES = 256 * 1024 * 1024
MAX_INPUT_BYTES = 64 * 1024
MAX_OBSERVED_OUTPUT_BYTES = 64 * 1024
RUN_TIMEOUT_SECONDS = 30
REPLAY_COUNT = 2
TARGET_EXCEPTION_EXIT_CODE = 10
# The target-worker's "completed with a control-plane sink-lexicon C call
# fired" exit (RA-01). Completed, never a crash; recorded per run.
TARGET_SINK_FIRED_EXIT_CODE = 20
_DIGEST = re.compile(r"^sha256:[0-9a-f]{64}$")
_SAFE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63})?$")

VERIFIED_TRIGGER = "verified_trigger"
VERIFIED_BEHAVIOR = "verified_behavior"
REJECTED = "rejected_under_test_conditions"
INCONCLUSIVE = "inconclusive"
ENVIRONMENT_ERROR = "environment_error"


class BundleError(Exception):
    """Bundle transport failed validation; never a claim about the target."""

    def __init__(self, code: str) -> None:
        super().__init__(code)
        self.code = code


def _digest(content: bytes) -> str:
    return "sha256:" + hashlib.sha256(content).hexdigest()


def _input_name_pattern(prefix: str) -> re.Pattern[str]:
    return re.compile(re.escape(prefix) + r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")


def _load_bundle(path: Path) -> dict[str, bytes]:
    """Extract declared members after digest verification; reject the rest."""

    try:
        raw = path.read_bytes()
    except OSError as error:
        raise BundleError("bundle_unreadable") from error
    if len(raw) > MAX_BUNDLE_BYTES:
        raise BundleError("bundle_too_large")
    members: dict[str, bytes] = {}
    try:
        with tarfile.open(fileobj=io.BytesIO(raw), mode="r:*") as archive:
            for info in archive:
                if info.isdir():
                    continue
                if not info.isfile():
                    # Symlinks, hardlinks and devices never enter the sandbox.
                    raise BundleError("bundle_member_not_regular_file")
                name = info.name
                if name.startswith("./"):
                    name = name[2:]
                if (
                    name != MANIFEST_NAME
                    and name != DRIVER_NAME
                    and name != TARGET_NAME
                    and not _input_name_pattern(INPUT_PREFIX).fullmatch(name)
                    and not _input_name_pattern(CONTROL_PREFIX).fullmatch(name)
                ):
                    raise BundleError("bundle_member_unexpected")
                if name in members:
                    raise BundleError("bundle_member_duplicate")
                limit = (
                    MAX_INPUT_BYTES
                    if name.startswith(INPUT_PREFIX) or name.startswith(CONTROL_PREFIX)
                    else MAX_MEMBER_BYTES
                )
                if info.size > limit:
                    raise BundleError("bundle_member_too_large")
                source = archive.extractfile(info)
                if source is None:
                    raise BundleError("bundle_member_unreadable")
                content = source.read(limit + 1)
                if len(content) != info.size:
                    raise BundleError("bundle_member_truncated")
                members[name] = content
    except tarfile.TarError as error:
        raise BundleError("bundle_not_tar") from error
    if MANIFEST_NAME not in members or DRIVER_NAME not in members or TARGET_NAME not in members:
        raise BundleError("bundle_member_missing")

    try:
        manifest = json.loads(members[MANIFEST_NAME].decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise BundleError("bundle_manifest_invalid") from error
    _check_manifest_shape(manifest)

    declared: dict[str, dict[str, object]] = {}
    for member in [manifest["driver"], manifest["target"], *(manifest.get("inputs") or []),
                   *(manifest.get("controls") or [])]:
        declared[str(member["name"])] = member
    if set(declared) | {MANIFEST_NAME} != set(members):
        raise BundleError("bundle_member_missing")
    for name, member in declared.items():
        content = members[name]
        if member["digest"] != _digest(content):
            raise BundleError("bundle_digest_mismatch")
        if member["size_bytes"] != len(content):
            raise BundleError("bundle_size_mismatch")
    return members


def _check_manifest_shape(manifest: object) -> None:
    if not isinstance(manifest, dict):
        raise BundleError("bundle_manifest_invalid")
    required = ("schema_version", "bundle_id", "finding_id", "kind", "driver", "target", "target_binding",
                "created_at")
    if any(key not in manifest for key in required):
        raise BundleError("bundle_manifest_invalid")
    if manifest["schema_version"] != "1.0.0" or manifest["kind"] != "proof":
        raise BundleError("bundle_manifest_unsupported")
    if not isinstance(manifest["bundle_id"], str) or not manifest["bundle_id"]:
        raise BundleError("bundle_manifest_invalid")
    if not isinstance(manifest["finding_id"], str) or not manifest["finding_id"]:
        raise BundleError("bundle_manifest_invalid")
    if not _member_shape_ok(manifest["driver"]) or manifest["driver"].get("name") != DRIVER_NAME:
        raise BundleError("bundle_manifest_invalid")
    if not _member_shape_ok(manifest["target"]) or manifest["target"].get("name") != TARGET_NAME:
        raise BundleError("bundle_manifest_invalid")
    for member in (manifest["driver"], manifest["target"]):
        if not _member_shape_ok(member):
            raise BundleError("bundle_manifest_invalid")
    for key in ("inputs", "controls"):
        if manifest.get(key) is not None:
            if not isinstance(manifest[key], list) or len(manifest[key]) > 8:
                raise BundleError("bundle_manifest_invalid")
            for member in manifest[key]:
                if not _member_shape_ok(member):
                    raise BundleError("bundle_manifest_invalid")
                expected_prefix = INPUT_PREFIX if key == "inputs" else CONTROL_PREFIX
                if not str(member["name"]).startswith(expected_prefix):
                    raise BundleError("bundle_manifest_invalid")
    binding = manifest["target_binding"]
    if not isinstance(binding, dict) or not all(
        isinstance(binding.get(key), str) and binding[key]
        for key in ("artifact_id", "version_id", "artifact_kind")
    ) or not _DIGEST.match(str(binding.get("digest", ""))):
        raise BundleError("bundle_manifest_invalid")
    constraint_digest = manifest.get("constraint_digest")
    if constraint_digest is not None and (
        not isinstance(constraint_digest, str) or not _DIGEST.match(constraint_digest)
    ):
        raise BundleError("bundle_manifest_invalid")
    inputs = manifest.get("inputs") or []
    controls = manifest.get("controls") or []
    if not inputs or not controls:
        raise BundleError("bundle_manifest_invalid")
    if manifest["target_binding"]["digest"] != manifest["target"]["digest"]:
        raise BundleError("target_binding_digest_mismatch")


def _member_shape_ok(member: object) -> bool:
    return (
        isinstance(member, dict)
        and _SAFE_NAME.match(str(member.get("name", ""))) is not None
        and _DIGEST.match(str(member.get("digest", ""))) is not None
        and isinstance(member.get("size_bytes"), int)
        and member["size_bytes"] > 0
    )


def _write_member(directory: Path, name: str, content: bytes, mode: int) -> Path:
    target = directory / name
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists() or target.is_symlink():
        raise BundleError("bundle_member_conflict")
    target.write_bytes(content)
    target.chmod(mode)
    return target


class _Run:
    __slots__ = ("role", "input_name", "exit_code", "signal", "duration_millis",
                 "target_frames", "timed_out", "output_digest", "sink_fired")

    def __init__(self, role: str, input_name: str) -> None:
        self.role = role
        self.input_name = input_name
        self.exit_code: int | None = None
        self.signal: int | None = None
        self.duration_millis = 0
        self.target_frames = False
        self.timed_out = False
        self.output_digest: str | None = None
        self.sink_fired = False

    def record(self) -> dict[str, object]:
        return {
            "role": self.role,
            "input_name": self.input_name,
            "exit_code": self.exit_code,
            "signal": self.signal,
            "duration_millis": self.duration_millis,
            "target_frames": self.target_frames,
            "timed_out": self.timed_out,
            "output_digest": self.output_digest,
            "sink_fired": self.sink_fired,
        }

    @property
    def crashed(self) -> bool:
        # Exit 20 is a completed run that executed a control-plane sink; it is
        # never a crash and never attributes a target exception.
        return self.exit_code is not None and self.exit_code not in (0, TARGET_SINK_FIRED_EXIT_CODE)

    @property
    def attributed(self) -> bool:
        return self.crashed and self.target_frames

    @property
    def completed(self) -> bool:
        return self.exit_code in (0, TARGET_SINK_FIRED_EXIT_CODE) and not self.timed_out


def _run_invocation(
    invocation: dict[str, str],
    target_bytes: bytes,
    target_digest: str,
    input_bytes: bytes,
    input_name: str,
    role: str,
) -> _Run:
    run = _Run(role, input_name)
    started = time.monotonic()
    try:
        with tempfile.TemporaryDirectory(
            prefix=f"vw-proof-{role}-", dir=_work_root()
        ) as run_dir_value:
            run_dir = Path(run_dir_value)
            target_path = _write_member(run_dir, "target.py", target_bytes, 0o444)
            input_path = _write_member(run_dir, "input.bin", input_bytes, 0o444)
            invocation_path = _write_member(
                run_dir,
                "invocation.json",
                json.dumps(invocation, ensure_ascii=True, sort_keys=True).encode("utf-8"),
                0o444,
            )
            output_path = run_dir / "observed-output.bin"
            worker = Path(__file__).with_name("vulnweaver-proof-target-worker")
            if not worker.is_file():
                raise BundleError("target_worker_unavailable")
            environment = {
                "PATH": os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin"),
                "PYTHONHASHSEED": "0",
                "PYTHONIOENCODING": "utf-8",
            }
            try:
                with output_path.open("wb") as output_stream:
                    process = subprocess.Popen(
                        [
                            sys.executable,
                            str(worker),
                            "--target",
                            str(target_path),
                            "--input",
                            str(input_path),
                            "--invocation",
                            str(invocation_path),
                            "--target-digest",
                            target_digest,
                        ],
                        stdin=subprocess.DEVNULL,
                        # Output lands in a file the supervisor reads back
                        # bounded; an unbounded stdout pipe could deadlock or
                        # balloon memory. The child keeps its inherited fd, so
                        # closing the parent copy here is safe.
                        stdout=output_stream,
                        stderr=subprocess.DEVNULL,
                        cwd=run_dir,
                        env=environment,
                        start_new_session=(os.name == "posix"),
                    )
            except OSError as error:
                raise BundleError("target_worker_unavailable") from error
            try:
                run.exit_code = process.wait(timeout=RUN_TIMEOUT_SECONDS)
            except subprocess.TimeoutExpired:
                run.timed_out = True
                _kill_process_group(process)
                process.wait()
            finally:
                # Kill descendants that inherited this invocation's session
                # before the supervisor writes the observation.
                _kill_process_group(process)
            if run.exit_code == TARGET_EXCEPTION_EXIT_CODE:
                run.target_frames = True
            elif run.exit_code == TARGET_SINK_FIRED_EXIT_CODE:
                # Interpreter-level sink-fire observation (RA-01): the worker
                # profiles control-plane lexicon C calls around the bound
                # invocation and encodes the reach fact in its exit status.
                run.sink_fired = True
            elif run.exit_code is not None and run.exit_code < 0:
                run.signal = -run.exit_code
            if run.completed:
                try:
                    observed = output_path.read_bytes()[:MAX_OBSERVED_OUTPUT_BYTES]
                    run.output_digest = _digest(observed)
                except OSError as error:
                    raise BundleError("target_worker_io_error") from error
    except BundleError:
        raise
    except OSError as error:
        raise BundleError("target_worker_io_error") from error
    run.duration_millis = int((time.monotonic() - started) * 1000)
    return run


def _kill_process_group(process: subprocess.Popen[bytes]) -> None:
    try:
        if os.name == "posix":
            os.killpg(process.pid, signal.SIGKILL)
        elif process.poll() is None:
            process.kill()
    except ProcessLookupError:
        pass


def _observation_id(finding_id: str, kind: str, bundle_id: str) -> str:
    seed = "\0".join((finding_id, kind, bundle_id)).encode("utf-8")
    return "observation:" + hashlib.sha256(seed).hexdigest()[:32]


def _member_echo(name: str, content: bytes) -> dict[str, object]:
    return {"name": name, "digest": _digest(content), "size_bytes": len(content)}


def execute_bundle(bundle_path: Path, finding_id: str, kind: str) -> dict[str, object]:
    members = _load_bundle(bundle_path)
    manifest = json.loads(members[MANIFEST_NAME].decode("utf-8"))
    if manifest["finding_id"] != finding_id:
        raise BundleError("bundle_finding_mismatch")
    target_binding = manifest["target_binding"]
    driver_digest = _digest(members[DRIVER_NAME])
    try:
        invocation = json.loads(members[DRIVER_NAME].decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise BundleError("invocation_invalid") from error
    if (
        not isinstance(invocation, dict)
        or set(invocation) != {"target_callable", "input_mode"}
        or not isinstance(invocation.get("target_callable"), str)
        or not re.fullmatch(
            r"[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*){0,7}",
            invocation["target_callable"],
        )
        or any(part.startswith("__") for part in invocation["target_callable"].split("."))
        or invocation.get("input_mode") not in {"text", "bytes", "json"}
    ):
        raise BundleError("invocation_invalid")
    input_names = [str(member["name"]) for member in manifest["inputs"]]
    control_names = [str(member["name"]) for member in manifest["controls"]]

    workdir = Path(tempfile.mkdtemp(prefix="vw-proof-", dir=_work_root()))
    try:
        input_paths = [
            _write_member(workdir, name, members[name], 0o444) for name in input_names
        ]
        control_paths = [
            _write_member(workdir, name, members[name], 0o444) for name in control_names
        ]
        target_bytes = members[TARGET_NAME]
        target_digest = manifest["target"]["digest"]
        control_runs = [
            _run_invocation(invocation, target_bytes, target_digest,
                            path.read_bytes(), path.name, "control")
            for path in control_paths
        ]
        trigger_runs = [
            _run_invocation(invocation, target_bytes, target_digest,
                            path.read_bytes(), path.name, "trigger")
            for path in input_paths
        ]
        reasons: list[str] = []
        chosen: _Run | None = next((run for run in trigger_runs if run.attributed), None)
        replay_runs: list[_Run] = []
        behavior_trigger: _Run | None = None
        if chosen is not None:
            index = next(i for i, run in enumerate(trigger_runs) if run is chosen)
            replay_runs = [
                _run_invocation(invocation, target_bytes, target_digest,
                                input_paths[index].read_bytes(), input_paths[index].name,
                                "replay")
                for _ in range(REPLAY_COUNT)
            ]
        else:
            # No attributed crash: the first cleanly completed trigger run can
            # still demonstrate input-dependent behavior. Replays establish
            # that the observed output is deterministic, not incidental noise.
            behavior_trigger = next((run for run in trigger_runs if run.completed), None)
            if behavior_trigger is not None:
                index = next(i for i, run in enumerate(trigger_runs) if run is behavior_trigger)
                replay_runs = [
                    _run_invocation(invocation, target_bytes, target_digest,
                                    input_paths[index].read_bytes(), input_paths[index].name,
                                    "replay")
                    for _ in range(REPLAY_COUNT)
                ]

        if any(run.timed_out for run in (*control_runs, *trigger_runs, *replay_runs)):
            verdict = INCONCLUSIVE
            reasons = ["target_timeout"]
        elif any(run.crashed for run in control_runs):
            verdict = REJECTED
            reasons = ["control_input_failed"]
        elif chosen is not None:
            if all(run.attributed for run in replay_runs):
                verdict = VERIFIED_TRIGGER
                reasons = ["target_exception_attributed", "control_input_clean", "replay_stable"]
            else:
                verdict = INCONCLUSIVE
                reasons = ["non_deterministic_trigger"]
        elif behavior_trigger is not None and all(run.completed for run in replay_runs):
            control_digest = next(
                (run.output_digest for run in control_runs if run.completed), None
            )
            crafted_digest = behavior_trigger.output_digest
            if control_digest is None or crafted_digest is None:
                verdict = REJECTED
                reasons = ["no_trigger_observed"]
            else:
                replay_consistent = all(
                    run.output_digest == crafted_digest for run in replay_runs
                )
                differed = crafted_digest != control_digest
                if differed and replay_consistent:
                    verdict = VERIFIED_BEHAVIOR
                    reasons = [
                        "behavior_difference_observed",
                        "control_input_clean",
                        "replay_stable",
                    ]
                else:
                    verdict = REJECTED
                    reasons = ["no_behavior_difference"]
        else:
            verdict = REJECTED
            reasons = (["target_not_involved"]
                       if any(run.crashed for run in trigger_runs)
                       else ["no_trigger_observed"])

        observed_behavior: dict[str, object] | None = None
        if verdict == VERIFIED_BEHAVIOR and behavior_trigger is not None:
            control_digest = next(
                run.output_digest for run in control_runs if run.completed
            )
            crafted_digest = behavior_trigger.output_digest
            assert crafted_digest is not None
            observed_behavior = {
                "crafted_output_digest": crafted_digest,
                "control_output_digest": control_digest,
                "differed": crafted_digest != control_digest,
                "replay_consistent": all(
                    run.output_digest == crafted_digest for run in replay_runs
                ),
            }

        runs = [run.record() for run in (*control_runs, *trigger_runs, *replay_runs)]
        trigger_count = sum(
            1 for run in (*trigger_runs, *replay_runs) if run.attributed
        )
        constraint_digest = manifest.get("constraint_digest")
        return {
            "schema_version": "1.0.0",
            "id": _observation_id(finding_id, kind, str(manifest["bundle_id"])),
            "kind": kind,
            "finding_id": finding_id,
            "verdict": verdict,
            "verdict_reasons": reasons,
            "driver_digest": driver_digest,
            "target_binding": {
                "artifact_id": target_binding["artifact_id"],
                "version_id": target_binding["version_id"],
                "artifact_kind": target_binding["artifact_kind"],
                "digest": target_binding["digest"],
            },
            "inputs": [_member_echo(name, members[name]) for name in input_names],
            "controls": [_member_echo(name, members[name]) for name in control_names],
            "runs": runs,
            "trigger_runs": trigger_count,
            "replay_runs": len(replay_runs),
            "untrusted_claims": None,
            "observed_behavior": observed_behavior,
            "constraint_digest": (
                constraint_digest
                if isinstance(constraint_digest, str) and _DIGEST.match(constraint_digest)
                else None
            ),
            "verifier": {"name": "proof-entrypoint", "version": "2.1.0",
                         "image_digest": None},
            "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        }
    finally:
        for path in sorted(workdir.rglob("*"), reverse=True):
            try:
                if path.is_file() or path.is_symlink():
                    path.unlink()
                elif path.is_dir():
                    path.rmdir()
            except OSError:
                pass
        try:
            workdir.rmdir()
        except OSError:
            pass


def _work_root() -> str:
    for candidate in ("/work", os.environ.get("TMPDIR", "/tmp")):
        if candidate and os.path.isdir(candidate) and os.access(candidate, os.W_OK):
            return candidate
    return tempfile.gettempdir()


def _environment_report(finding_id: str, kind: str, code: str) -> dict[str, object]:
    return {
        "schema_version": "1.0.0",
        "id": _observation_id(finding_id, kind, "invalid"),
        "kind": kind,
        "finding_id": finding_id,
        "verdict": ENVIRONMENT_ERROR,
        "verdict_reasons": [code],
        "driver_digest": "sha256:" + "0" * 64,
        "target_binding": {
            "artifact_id": "artifact:unknown",
            "version_id": "artifact-version:unknown",
            "artifact_kind": "source_archive",
            "digest": "sha256:" + "0" * 64,
        },
        "inputs": [],
        "controls": [],
        "runs": [],
        "trigger_runs": 0,
        "replay_runs": 0,
        "untrusted_claims": None,
        "verifier": {"name": "proof-entrypoint", "version": "2.0.0",
                     "image_digest": None},
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--bundle", type=Path, required=True)
    parser.add_argument("--finding-id", required=True)
    parser.add_argument("--kind", choices=("proof_of_concept", "exploit"), required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    args = parser.parse_args()
    args.output_dir.mkdir(parents=True, exist_ok=True)
    try:
        report = execute_bundle(args.bundle, args.finding_id, args.kind)
    except BundleError as error:
        report = _environment_report(args.finding_id, args.kind, error.code)
    report_path = args.output_dir / REPORT_NAME
    if report_path.is_symlink() or report_path.exists():
        report_path.unlink()
    report_path.write_text(
        json.dumps(report, ensure_ascii=True, sort_keys=True), encoding="utf-8"
    )
    return 0 if report["verdict"] != ENVIRONMENT_ERROR else 1


if __name__ == "__main__":
    raise SystemExit(main())
